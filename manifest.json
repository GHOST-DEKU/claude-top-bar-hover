{
  "manifest_version": 3,
  "name": "Claude Top Bar on Hover",
  "version": "1.1.4",
  "description": "Hides the top bar on claude.ai and shows it only when you hover over it. Open the popup to change how.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Claude Top Bar on Hover",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Show or hide the Claude top bar"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
